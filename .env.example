# Copy these values into your process environment before starting PHP and Flask.
# Do not commit a real .env file.
ECHOTRACE_JWT_SECRET=replace-with-a-random-32-character-or-longer-secret
ECHOTRACE_FLASK_SECRET_KEY=replace-with-a-different-random-32-character-or-longer-secret
ECHOTRACE_SERVICE_KEY=replace-with-a-third-random-32-character-or-longer-secret

# Optional database overrides; the values below preserve the local development defaults.
ECHOTRACE_DB_HOST=127.0.0.1
ECHOTRACE_DB_NAME=echotrace
ECHOTRACE_DB_USER=root
ECHOTRACE_DB_PASSWORD=

# Comma-separated browser origins allowed to call the PHP API.
ECHOTRACE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost,http://127.0.0.1
ECHOTRACE_DEBUG=0
ECHOTRACE_COOKIE_SECURE=0

# Optional outbound HTTP(S) proxy for marketplace retrieval. Leave empty when
# the PHP host has direct outbound HTTPS access. Never disable TLS verification.
ECHOTRACE_HTTPS_PROXY=

# Optional explicit store-host allowlists. Store adapters remain disabled when
# these are empty; arbitrary public domains are never auto-probed.
ECHOTRACE_SHOPIFY_HOSTS=
ECHOTRACE_WOOCOMMERCE_HOSTS=
